# UniAI Chat Web - Environment Configuration
# Copy this file to .env in the project root or set these variables before starting

# Server mode (chat = lightweight, no board/terminal/spec routes)
AUTOMAKER_MODE=chat

# Backend server port (shared with Automaker UI)
PORT=3008

# Chat UI dev server port
CHAT_PORT=3009

# Hostname for API URLs
VITE_HOSTNAME=localhost
